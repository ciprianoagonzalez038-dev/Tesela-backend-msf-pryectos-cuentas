# Copia este archivo a .env (NO se versiona) y define un valor propio.
# Generar uno (PowerShell):
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
# Debe ser el MISMO valor en ms-xrello-cuentas y ms-xrello-tableros (minimo 32 caracteres).
XRELLO_JWT_SECRET=

# Secreto compartido con ms-usuario (header X-Internal-Token) -- D28/Tesela: el login y el alta de
# cuenta se verifican/crean contra ms-usuario (ver UsuarioDirectorioClient), nunca contra una tabla
# local de contrasenas. MISMO valor que app.internal.token de ms-usuario (y que USUARIO_INTERNAL_TOKEN
# en ms3-oauth/app_admin_web).
USUARIO_INTERNAL_TOKEN=

# Trazas distribuidas (infra-tracing): usuario/clave de RabbitMQ. Los MISMOS valores que RABBIT_USERNAME /
# RABBIT_PASSWORD de infra-tracing/.env (>= 32 caracteres). El servicio en contenedor no arranca sin ellos.
ZIPKIN_RABBIT_USERNAME=
ZIPKIN_RABBIT_PASSWORD=

# Clave del usuario de BD xrello en el MySQL de infra-db (mismo valor que DB_PASS_XRELLO de infra-db/.env). SIN default.
DB_PASSWORD=

# API key del cliente "Proyectos" en ms-mensajeria (formato tsl_<prefijo>_<secreto>). La entrega ms-mensajeria UNA sola vez en
# POST /api/admin/mensajeria/clientes. Secreto: no se versiona ni se loguea. La URL de ms-mensajeria NO va aqui: esta en la
# tabla de parametrizacion (URL_MENSAJERIA).
MENSAJERIA_API_KEY=
